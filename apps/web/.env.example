OPENROUTER_API_KEY=your_openrouter_key_here
# Required for mobile auth (use a long random string)
AUTH_JWT_SECRET=replace_with_long_random_secret
# Optional: override JWT issuer
# AUTH_JWT_ISSUER=twentynine
# Required to send push notifications from the server
PUSH_ADMIN_TOKEN=replace_with_admin_token
# Optional: override where push tokens are stored
# PUSH_TOKEN_STORE_PATH=/absolute/path/to/push-tokens.json
# Optional: override OpenRouter JSONL log path (defaults to <repo>/.logs/openrouter.jsonl)
# OPENROUTER_LOG_PATH=/absolute/path/to/openrouter.jsonl
